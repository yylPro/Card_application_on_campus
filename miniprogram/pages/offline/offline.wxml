<view class="page">
  <view wx:if="{{!loggedIn}}" class="card"><view class="eyebrow">线下实体端</view><text class="muted">授权实体店工作人员登录后核验学生二维码。</text><input wx:if="{{mode === 'register'}}" class="input" data-key="staffName" bindinput="setField" placeholder="工作人员姓名" /><input wx:if="{{mode === 'register'}}" class="input" data-key="gridName" bindinput="setField" placeholder="所属网格（分公司授权账号可不填）" /><input class="input" type="number" maxlength="11" data-key="phone" bindinput="setField" placeholder="授权手机号" /><input class="input" password data-key="password" bindinput="setField" placeholder="密码" /><view wx:if="{{mode === 'login'}}" class="login-options"><checkbox-group bindchange="changeLoginOptions"><label><checkbox value="password" checked="{{rememberPassword}}" />记住密码</label><label><checkbox value="auto" checked="{{autoLogin}}" />自动登录</label></checkbox-group></view><input wx:if="{{mode === 'register'}}" class="input" password data-key="confirmPassword" bindinput="setField" placeholder="确认密码" /><text wx:if="{{mode === 'register'}}" class="hint">分公司授权账号不需要填写网格；普通线下账号必须填写所属网格。</text><button class="primary" bindtap="login">{{mode === 'register' ? '注册' : '登录'}}</button><button class="link" bindtap="switchMode">{{mode === 'register' ? '已有账号，返回登录' : '没有账号，立即注册'}}</button></view>
  <block wx:else>
    <view class="section-head"><view class="section-title">实名核验</view><button size="mini" bindtap="logout">退出登录</button></view>
    <view class="card"><text class="muted">扫描学生二维码或输入校园号码，再提交套卡实名已激活页面。</text><button class="primary" bindtap="scanFeatureCode">扫描特征码二维码</button><text wx:if="{{scanFeatureCode}}" class="success">已读取：{{scanFeatureCode}}</text><input class="input" data-key="campusNumber" bindinput="setField" placeholder="请输入校园号码" /><button size="mini" bindtap="chooseActivationProof">提交套卡实名已激活页面</button><image wx:if="{{activationProofPreview}}" class="proof-image" src="{{activationProofPreview}}" mode="aspectFit" /><button wx:if="{{activationProofPreview}}" size="mini" bindtap="clearActivationProof">重新选择页面</button><button class="primary" bindtap="verifyScanned">提交实名核验</button></view>
    <view class="card"><text class="muted">批量导入备用：每行一条，格式为校园号码，验证结果；使用上方已提交的套卡实名页面。</text><textarea class="textarea" data-key="messageText" bindinput="setField" placeholder="138****0001，verified" /><button class="primary" bindtap="importMessages">批量提交实名核验</button></view>
    <view class="card"><text class="muted">仅导出当前线下账号核验成功的名单，用于统计核验数量。</text><button class="primary" bindtap="exportVerified">导出已核验名单</button></view>
    <view wx:for="{{results}}" wx:key="featureCode" class="card"><view class="record-title">{{item.featureCode}}</view><text class="muted">{{item.message}}</text><text wx:if="{{item.displayNumber}}" class="muted">号码：{{item.displayNumber}}</text></view>
  </block>
</view>
