<view class="page"><view class="card"><view class="eyebrow">{{title}}</view><view class="field">{{phoneLabel}}<input class="input" data-key="phone" type="number" maxlength="11" bindinput="setField" placeholder="{{placeholder}}" /></view><button class="primary" bindtap="lookup">{{queryText}}</button></view><view wx:if="{{emptyMessage}}" class="card muted">{{emptyMessage}}</view><view wx:for="{{records}}" wx:key="id" class="card"><text class="record-title">{{item.type}}</text><text class="muted">{{item.id}} · {{item.appointment}}</text><text wx:if="{{item.featureCode}}" class="muted">特征码：{{item.featureCode}}</text><view wx:if="{{item.featureQrDataUrl}}" class="qr-card"><image class="feature-qr" src="{{item.featureQrDataUrl}}" mode="widthFix" /><text class="muted">请在线下端扫码，再输入校园号码完成核验</text></view><text wx:if="{{item.selectedNumber}}" class="muted">号码：{{item.selectedNumber}} · {{item.operator}}</text><text wx:if="{{item.outletAddress}}" class="muted">线下办理地址：{{item.outletAddress}}</text><text wx:if="{{item.waitingOffline}}" class="muted">线下办理地址和特征码待运营商分配，请稍后刷新查询。</text><text wx:if="{{item.deliveryRecipient}}" class="muted">收货信息：{{item.deliveryRecipient}} · {{item.deliveryPhone}} · {{item.address}}</text><text class="status">{{item.statusText}}</text><button wx:if="{{item.canConfirm}}" size="mini" class="confirm-button" bindtap="confirm" data-id="{{item.id}}">确认完成并评价</button></view></view>
