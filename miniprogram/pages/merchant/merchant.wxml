<view class="page">
  <view wx:if="{{!loggedIn}}" class="card"><view class="eyebrow">商家兑换端</view><text class="muted">查询线下已核验订单并确认兑换激活。</text><input wx:if="{{mode === 'register'}}" class="input" data-key="staffName" bindinput="setField" placeholder="商家姓名" /><input class="input" type="number" maxlength="11" data-key="phone" bindinput="setField" placeholder="授权手机号" /><input class="input" password data-key="password" bindinput="setField" placeholder="密码" /><view wx:if="{{mode === 'login'}}" class="login-options"><checkbox-group bindchange="changeLoginOptions"><label><checkbox value="password" checked="{{rememberPassword}}" />记住密码</label><label><checkbox value="auto" checked="{{autoLogin}}" />自动登录</label></checkbox-group></view><input wx:if="{{mode === 'register'}}" class="input" password data-key="confirmPassword" bindinput="setField" placeholder="确认密码" /><button class="primary" bindtap="login">{{mode === 'register' ? '注册' : '登录'}}</button><button class="link" bindtap="switchMode">{{mode === 'register' ? '已有账号，返回登录' : '没有账号，立即注册'}}</button></view>
  <block wx:else>
    <view class="section-head"><view class="section-title">商家兑换查询</view><button size="mini" bindtap="logout">退出登录</button></view>
    <view class="card"><text class="muted">输入校园号码，查询线下实名核验状态。</text><input class="input" data-key="campusNumber" bindinput="setField" placeholder="请输入校园号码" /><button class="primary" loading="{{querying}}" disabled="{{querying}}" bindtap="queryOrder">查询</button></view>
    <view wx:if="{{result}}" class="card"><view class="record-title">{{result.status === 'verified' ? '已核验' : '未核验'}}</view><text class="muted">{{result.message}}</text><text wx:if="{{result.record && result.record.name}}" class="muted">姓名：{{result.record.name}}</text><text wx:if="{{result.record && result.record.schoolName}}" class="muted">学校：{{result.record.schoolName}}　学院：{{result.record.college}}</text><button wx:if="{{result.canConfirm}}" class="primary" bindtap="confirmActivation">确认激活</button></view>
  </block>
</view>
