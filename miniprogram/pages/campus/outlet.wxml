<view class="page">
  <view wx:if="{{!loggedIn}}" class="panel login-panel"><view class="section-title">线下实体端登录</view><view class="section-copy">仅限已授权实体店工作人员手机号注册和登录，学生特征码不能用于登录。</view><view class="auth-mode"><button size="mini" class="{{authMode === 'login' ? 'mode-active' : ''}}" bindtap="setMode" data-mode="login">登录</button><button size="mini" class="{{authMode === 'register' ? 'mode-active' : ''}}" bindtap="setMode" data-mode="register">注册</button></view><input class="input" type="number" maxlength="11" value="{{phone}}" data-key="phone" bindinput="setField" placeholder="授权手机号" /><input class="input" password value="{{password}}" data-key="password" bindinput="setField" placeholder="登录密码" /><input wx:if="{{authMode === 'register'}}" class="input" password value="{{confirmPassword}}" data-key="confirmPassword" bindinput="setField" placeholder="确认密码" /><button class="primary" bindtap="login">{{authMode === 'register' ? '注册并进入实名工作台' : '进入实名工作台'}}</button></view>
  <block wx:else>
    <view class="section-head"><view class="section-title">导入实名验证消息</view><button size="mini" bindtap="logout">退出登录</button></view><view class="section-copy">每行一条：特征码，身份证号码，验证结果。学生特征码只用于匹配订单，不用于登录。</view>
    <view class="panel"><textarea class="textarea import-area" data-key="messageText" value="{{messageText}}" bindinput="setField" placeholder="CAMPUS-AB12CD34，身份证号码，verified" /><button class="primary" bindtap="importMessages">导入并激活</button></view>
    <view wx:if="{{results.length}}" class="section-head"><view class="section-title">处理结果</view></view>
    <view wx:for="{{results}}" wx:key="featureCode" class="record"><view class="record-top"><text>{{item.featureCode}}</text><text class="status {{item.success ? 'activated' : 'failed'}}">{{item.success ? '成功' : '失败'}}</text></view><view class="record-line">{{item.message}}</view><view wx:if="{{item.schoolName}}" class="record-line">学校：{{item.schoolName}}　学院：{{item.college}}</view><view wx:if="{{item.displayNumber}}" class="record-line">号码：{{item.displayNumber}}</view></view>
  </block>
</view>
