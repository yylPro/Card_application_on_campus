<view class="page">
  <view wx:if="{{!loggedIn}}" class="panel login-panel"><view class="section-title">线下实体端登录</view><view class="section-copy">使用与运营商端相同的云函数管理口令。</view><input class="input" password value="{{staffKey}}" data-key="staffKey" bindinput="setField" placeholder="管理口令" /><button class="primary" bindtap="login">进入实名工作台</button></view>
  <block wx:else>
    <view class="section-head"><view class="section-title">导入实名验证消息</view><view class="section-copy">每行一条：特征码，身份证号码，验证结果。验证结果可填 verified、通过或成功。</view></view>
    <view class="panel"><textarea class="textarea import-area" data-key="messageText" value="{{messageText}}" bindinput="setField" placeholder="CAMPUS-AB12CD34，身份证号码，verified" /><button class="primary" bindtap="importMessages">导入并激活</button></view>
    <view wx:if="{{results.length}}" class="section-head"><view class="section-title">处理结果</view></view>
    <view wx:for="{{results}}" wx:key="featureCode" class="record"><view class="record-top"><text>{{item.featureCode}}</text><text class="status {{item.success ? 'activated' : 'failed'}}">{{item.success ? '成功' : '失败'}}</text></view><view class="record-line">{{item.message}}</view><view wx:if="{{item.displayNumber}}" class="record-line">号码：{{item.displayNumber}}</view></view>
  </block>
</view>
