@import "../../styles/campus.wxss";

.upload-field { align-items: flex-start; }
.id-card-preview { display: block; width: 100%; height: 180rpx; margin-top: 16rpx; background: #f4f6f8; border-radius: 8rpx; }
.search-input { margin-bottom: 12rpx; }
.search-results { margin: 0 0 12rpx; max-height: 280rpx; overflow-y: auto; border: 1rpx solid #dce3e8; border-radius: 8rpx; background: #fff; }
.search-result { padding: 18rpx 20rpx; border-bottom: 1rpx solid #edf0f2; color: #263238; font-size: 28rpx; line-height: 1.4; }
.search-result:last-child { border-bottom: 0; }
.search-empty { padding: 18rpx 20rpx; color: #718096; font-size: 26rpx; }
.selected-search-value { padding: 8rpx 0; color: #52606d; font-size: 26rpx; }
