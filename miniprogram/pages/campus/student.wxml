<view class="page">
  <view class="section-head">
    <view class="section-title">选择号码</view>
    <view class="section-copy">号码将在提交成功后锁定，实名验证完成后正式激活。</view>
  </view>
  <view class="panel">
    <view class="field">
      <view class="field-label">学校</view>
      <input class="input search-input" value="{{schoolKeyword}}" bindinput="searchSchools" placeholder="输入学校关键词搜索" />
      <view wx:if="{{schoolKeyword}}" class="search-results">
        <view wx:for="{{filteredSchools}}" wx:key="code" class="search-result" bindtap="selectSchoolFromSearch" data-code="{{item.code}}">{{item.name}}</view>
        <view wx:if="{{!filteredSchools.length}}" class="search-empty">未找到匹配学校</view>
      </view>
      <view wx:if="{{schoolName}}" class="selected-search-value">已选：{{schoolName}}</view>
    </view>
    <view class="field">
      <view class="field-label">学院</view>
      <input class="input search-input" value="{{collegeKeyword}}" bindinput="searchColleges" placeholder="输入学院关键词搜索" disabled="{{!schoolCode}}" />
      <view wx:if="{{collegeKeyword}}" class="search-results">
        <view wx:for="{{filteredColleges}}" wx:key="*this" class="search-result" bindtap="selectCollegeFromSearch" data-college="{{item}}">{{item}}</view>
        <view wx:if="{{!filteredColleges.length}}" class="search-empty">未找到匹配学院</view>
      </view>
      <view wx:if="{{college}}" class="selected-search-value">已选：{{college}}</view>
    </view>
    <view class="field">
      <view class="field-label">运营商</view>
      <picker range="{{operators}}" value="{{operatorIndex}}" bindchange="pickOperator">
        <view class="picker">{{operators[operatorIndex]}} <text class="picker-arrow">⌄</text></view>
      </picker>
    </view>
    <view class="offer-grid">
      <view wx:for="{{offers}}" wx:key="id" class="offer {{selectedOfferId === item.id ? 'offer-selected' : ''}}" bindtap="selectOffer" data-id="{{item.id}}">
        <view class="offer-number">{{item.displayNumber}}</view>
        <view class="offer-plan">{{item.planName}}</view>
        <view class="offer-fee">{{item.monthlyFee}} 元/月</view>
        <view wx:if="{{selectedOfferId === item.id}}" class="selected-mark">已选择</view>
      </view>
    </view>
    <view wx:if="{{!offers.length}}" class="empty">暂无可选号码，请联系运营商导入库存。</view>
    <view class="pager">
      <button size="mini" bindtap="previousPage" disabled="{{page <= 1}}">上一页</button>
      <text>第 {{page}} / {{totalPages}} 页</text>
      <button size="mini" bindtap="nextPage" disabled="{{page >= totalPages}}">下一页</button>
    </view>
  </view>
  <view class="panel">
    <view class="section-title small-title">填写预约信息</view>
    <view class="field"><view class="field-label">姓名</view><input class="input" data-key="name" value="{{name}}" bindinput="setField" placeholder="请输入姓名" /></view>
    <view class="field"><view class="field-label">学号（可选）</view><input class="input" data-key="studentNo" value="{{studentNo}}" bindinput="setField" placeholder="请输入学号" /></view>
    <view class="field"><view class="field-label">身份证号码</view><input class="input" data-key="idCard" value="{{idCard}}" bindinput="setField" type="text" maxlength="18" placeholder="请输入身份证号码" /></view>
    <view class="field"><view class="field-label">联系电话</view><input class="input" data-key="phone" value="{{phone}}" bindinput="setField" type="number" maxlength="11" placeholder="请输入手机号" /></view>
    <view class="field"><view class="field-label">收货人</view><input class="input" data-key="shippingRecipient" value="{{shippingRecipient}}" bindinput="setField" placeholder="请输入收货人姓名" /></view>
    <view class="field"><view class="field-label">联系号码</view><input class="input" data-key="shippingPhone" value="{{shippingPhone}}" bindinput="setField" type="number" maxlength="11" placeholder="请输入收货联系电话" /></view>
    <view class="field"><view class="field-label">收货地址</view><input class="input" data-key="shippingAddress" value="{{shippingAddress}}" bindinput="setField" placeholder="请输入详细收货地址" /></view>
    <view class="field upload-field">
      <view class="field-label">身份证人像面</view>
      <button size="mini" bindtap="chooseIdCard" data-side="front">{{idCardFrontPath ? '重新选择' : '上传图片'}}</button>
      <image wx:if="{{idCardFrontPath}}" class="id-card-preview" src="{{idCardFrontPath}}" mode="aspectFit"></image>
    </view>
    <view class="field upload-field">
      <view class="field-label">身份证国徽面</view>
      <button size="mini" bindtap="chooseIdCard" data-side="back">{{idCardBackPath ? '重新选择' : '上传图片'}}</button>
      <image wx:if="{{idCardBackPath}}" class="id-card-preview" src="{{idCardBackPath}}" mode="aspectFit"></image>
    </view>
    <button class="primary" loading="{{loading}}" bindtap="reserve">提交选号</button>
  </view>
  <view wx:if="{{orders.length}}" class="section-head"><view class="section-title">我的办理记录</view></view>
  <view wx:for="{{orders}}" wx:key="id" class="record">
    <view class="record-top"><text>{{item.displayNumber}}</text><text class="status {{item.status}}">{{item.status === 'activated' ? '已激活' : '待实名'}}</text></view>
    <view class="record-line">收货信息：{{item.shippingRecipient}} · {{item.shippingPhone}}</view>
    <view class="record-line">收货地址：{{item.shippingAddress}}</view>
    <view class="record-line">特征码：{{item.featureCode}}</view>
    <view class="record-line">办理地址：{{item.outletAddress}}</view>
    <view wx:if="{{item.verifiedAt}}" class="record-line">身份证后四位：{{item.idCardLast4}}</view>
  </view>
</view>
