<view class="page">
  <view class="card">
    <view class="eyebrow">{{title}}</view>
    <text class="muted">请填写预约信息，工作人员会根据提交内容联系您。</text>
    <view class="field">姓名<input class="input" data-key="name" bindinput="setField" placeholder="请输入姓名" /></view>
    <view class="field">学号（可选）<input class="input" data-key="studentNo" bindinput="setField" placeholder="如有请填写" /></view>
    <view class="field">身份证号<input class="input" data-key="idCard" maxlength="18" bindinput="setField" placeholder="请输入身份证号" /></view>
    <view class="field">二级学院<input class="input" value="{{college}}" disabled placeholder="请返回首页选择二级学院" /></view>
    <view class="field">现有联系电话<input class="input" data-key="phone" type="number" maxlength="11" bindinput="setField" placeholder="请输入现有联系电话" /></view>
    <view class="field">地址（选填）<textarea class="textarea" data-key="address" bindinput="setField" placeholder="如需上门或联系地址，可填写详细地址" /></view>
    <checkbox-group bindchange="toggleService"><label class="consent"><checkbox value="service" checked="{{serviceConsent}}" />我同意将上述信息用于校园通信服务信息收集和后续联系。</label></checkbox-group>
    <button class="primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">提交预约</button>
  </view>
</view>
