.picker { height: 80rpx; margin-top: 10rpx; padding: 0 18rpx; border: 1rpx solid #cbd8e1; border-radius: 8rpx; background: #fff; line-height: 80rpx; font-size: 28rpx; font-weight: 400; }
.textarea { box-sizing: border-box; width: 100%; height: 160rpx; margin-top: 10rpx; padding: 16rpx; border: 1rpx solid #cbd8e1; border-radius: 8rpx; background: #fff; font-size: 28rpx; font-weight: 400; }
.image-row { display: flex; gap: 20rpx; margin-top: 12rpx; }
.image-picker { width: 300rpx; height: 190rpx; border: 1rpx dashed #9fb5c5; border-radius: 8rpx; background: #f7fafc; display: flex; align-items: center; justify-content: center; color: #567080; font-size: 26rpx; overflow: hidden; }
.image-picker image { width: 100%; height: 100%; }
.hint { display: block; margin-top: 10rpx; color: #71818b; font-size: 24rpx; line-height: 1.5; }
