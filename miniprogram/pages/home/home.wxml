<view class="page">
  <view class="hero"><text class="hero-kicker">{{schoolName}}</text><text class="hero-title">线上预约，线下办理</text><text class="hero-copy">选号、校园网预约、宽带报修和进度查询</text></view>
  <view class="card"><view class="eyebrow">先选择学校</view><input class="input" value="{{schoolQuery}}" bindinput="searchSchools" placeholder="请输入学校名称的前几个字" /><view wx:for="{{schools}}" wx:key="code" class="service-item" bindtap="chooseSchool" data-index="{{index}}"><text>{{item.name}}</text><text class="arrow">›</text></view></view>
  <view class="card"><view class="eyebrow">服务办理</view><view wx:for="{{services}}" wx:key="title" class="service-item" bindtap="openService" data-title="{{item.title}}" data-kind="{{item.kind}}"><text>{{item.title}}</text><text class="arrow">›</text></view></view>
  <view class="card" bindtap="openRecords"><view class="service-item"><text>查询服务进度</text><text class="arrow">›</text></view></view>
</view>
