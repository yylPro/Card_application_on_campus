<view class="page">
  <view class="hero"><text class="hero-kicker">{{schoolName}}</text><text class="hero-title">{{heroTitle}}</text><text class="hero-copy">{{heroCopy}}</text></view>
  <view class="card"><view class="eyebrow">{{schoolLabel}}</view><input class="input" value="{{schoolQuery}}" bindinput="searchSchools" placeholder="{{searchPlaceholder}}" /><view wx:if="{{searching}}" class="muted">{{searchingLabel}}</view><view wx:for="{{schools}}" wx:key="code" class="service-item" bindtap="chooseSchool" data-index="{{index}}"><text>{{item.name}}</text><text class="arrow">{{arrow}}</text></view><view wx:if="{{!searching && schoolQuery && !schools.length}}" class="muted">{{noSchools}}</view></view>
  <view class="card"><view class="eyebrow">{{collegeLabel}}</view><picker range="{{colleges}}" bindchange="pickCollege"><view class="picker">{{college || collegePlaceholder}}</view></picker></view>
  <view class="card"><view class="eyebrow">{{serviceLabel}}</view><text class="muted">请填写预约信息，工作人员会根据提交内容联系您。</text><view class="field">姓名<input class="input" data-key="name" bindinput="setField" placeholder="请输入姓名" /></view><view class="field">学号（可选）<input class="input" data-key="studentNo" bindinput="setField" placeholder="如有请填写" /></view><view class="field">身份证号<input class="input" data-key="idCard" maxlength="18" bindinput="setField" placeholder="请输入身份证号" /></view><view class="field">现有联系电话<input class="input" data-key="phone" type="number" maxlength="11" bindinput="setField" placeholder="请输入现有联系电话" /></view><view class="field">地址（选填）<textarea class="textarea address-input" data-key="address" bindinput="setField" placeholder="如需上门或联系地址，可填写详细地址" /></view><checkbox-group bindchange="toggleService"><label class="consent"><checkbox value="service" checked="{{serviceConsent}}" />我同意将上述信息用于校园通信服务信息收集和后续联系。</label></checkbox-group><button class="primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitOrder">提交预约</button></view>
  <view class="card records-query-card"><view class="records-query-head"><view><text class="records-query-title">{{recordsLabel}}</text><text class="records-query-subtitle">只查询当前微信账号提交的订单</text></view><button class="query-button" loading="{{recordsLoading}}" disabled="{{recordsLoading}}" bindtap="lookupOwnRecords">查询</button></view><view wx:if="{{recordsMessage}}" class="records-message">{{recordsMessage}}</view></view>
  <view wx:for="{{records}}" wx:key="id" class="card record-card"><view class="record-head"><view class="record-summary"><text class="record-title">{{item.type}}</text><text class="record-code">服务编号：{{item.id}}</text></view><button wx:if="{{item.featureCode}}" class="qr-corner-button" size="mini" bindtap="toggleFeatureQr" data-index="{{index}}">{{item.showFeatureQr ? '隐藏二维码' : '核销二维码'}}</button></view><text wx:if="{{item.featureCode}}" class="muted">订单核销码：{{item.featureCode}}</text><view wx:if="{{item.showFeatureQr && item.featureQrDataUrl}}" class="qr-card"><view class="qr-wrap"><image class="feature-qr" src="{{item.featureQrDataUrl}}" mode="widthFix" /><text wx:if="{{item.verificationStatus === 'verified'}}" class="verified-mask">已核销</text></view></view><view class="record-details"><text wx:if="{{item.selectedNumber}}" class="muted">号码：{{item.selectedNumber}} · {{item.operator}}</text><text wx:if="{{item.outletAddress}}" class="muted">线下办理地址：{{item.outletAddress}}</text><text wx:if="{{item.deliveryRecipient}}" class="muted">收货信息：{{item.deliveryRecipient}} · {{item.deliveryPhone}} · {{item.address}}</text></view><text class="status {{item.statusText === '已完成' ? 'status-completed' : ''}}">{{item.statusText}}</text></view>
</view>
