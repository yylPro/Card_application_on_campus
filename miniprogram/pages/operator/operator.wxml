<view class="page">
  <view wx:if="{{!loggedIn}}" class="card"><view class="eyebrow">运营商管理端</view><text class="muted">授权工作人员登录后处理订单。</text><input wx:if="{{mode === 'register'}}" class="input" data-key="staffName" bindinput="setField" placeholder="工作人员姓名" /><input wx:if="{{mode === 'register'}}" class="input" data-key="gridName" bindinput="setField" placeholder="所属网格（青秀区分公司账号可不填）" /><input class="input" type="number" maxlength="11" data-key="phone" bindinput="setField" placeholder="手机号" /><input class="input" password data-key="password" bindinput="setField" placeholder="密码" /><view wx:if="{{mode === 'login'}}" class="login-options"><checkbox-group bindchange="changeLoginOptions"><label><checkbox value="password" checked="{{rememberPassword}}" />记住密码</label><label><checkbox value="auto" checked="{{autoLogin}}" />自动登录</label></checkbox-group></view><input wx:if="{{mode === 'register'}}" class="input" password data-key="confirmPassword" bindinput="setField" placeholder="确认密码" /><text wx:if="{{mode === 'register'}}" class="hint">网格账号必须填写所属网格；分公司授权号可不填网格。</text><button class="primary" bindtap="login">{{mode === 'register' ? '注册' : '登录'}}</button><button class="link" bindtap="switchMode">{{mode === 'register' ? '已有账号，返回登录' : '没有账号，立即注册'}}</button></view>
  <block wx:else>
    <view class="section-head"><view class="section-title">运营商管理</view><button size="mini" bindtap="logout">退出登录</button></view>
    <view wx:if="{{operatorScope === 'branch'}}" class="card"><view class="section-title">统一线下实名地址</view><text class="muted">新订单自动使用此地址；已经发出的地址和特征码不会因修改而失效。</text><input class="input" data-key="globalAddress" bindinput="setField" value="{{globalAddress}}" placeholder="例如：东校区迎新服务点 A03" /><view class="row"><button class="primary" bindtap="saveGlobalAddress">保存统一地址</button><button size="mini" bindtap="clearGlobalAddress">清空</button></view></view>
    <view class="card"><view class="section-title">导出订单</view><text class="muted">请选择名单类型；已激活名单可按核验日期筛选。</text><view class="export-controls"><checkbox-group bindchange="changeExportKind"><label class="export-option"><checkbox value="activated" checked="{{exportKind === 'activated'}}" />已激活</label><label class="export-option"><checkbox value="pending" checked="{{exportKind === 'pending'}}" />未激活</label></checkbox-group><button class="primary export-button" bindtap="exportOrders">导出表格</button></view><view class="row"><input class="input" type="date" data-key="dateFrom" bindinput="setField" value="{{dateFrom}}" placeholder="开始日期" /><input class="input" type="date" data-key="dateTo" bindinput="setField" value="{{dateTo}}" placeholder="结束日期" /></view></view>
    <view class="section-head"><view class="section-title">订单（共 {{totalOrders}} 条）</view><button size="mini" bindtap="loadOrders">刷新</button></view>
    <view wx:if="{{operatorScope === 'grid'}}" class="muted">当前网格：{{accountGrid}}</view>
    <view wx:if="{{operatorScope === 'branch'}}" class="card grid-filter"><view class="field">选择查看网格</view><picker range="{{gridOptions}}" bindchange="pickGrid"><view class="picker">{{selectedGrid}}</view></picker></view>
    <view wx:if="{{!orders.length}}" class="card muted">暂无订单</view>
    <view wx:for="{{orders}}" wx:key="id" class="card"><view class="record-title">{{item.name}} · {{item.displayNumber}}</view><text class="muted">学校：{{item.schoolName}}　学院：{{item.college}}</text><text class="muted">校园号码：{{item.campusNumber}}</text><text class="muted">特征码：{{item.featureCode}}　运营商：{{item.operator}}</text><text class="muted">收货人：{{item.deliveryRecipient}}　电话：{{item.deliveryPhone}}</text><text class="muted">地址：{{item.address}}</text><text wx:if="{{item.outletAddress}}" class="muted">线下办理地址：{{item.outletAddress}}</text><text wx:if="{{item.verifiedByPhone}}" class="muted">实名核验账号：{{item.verifiedByName}}　{{item.verifiedByPhone}}</text><text wx:if="{{item.merchantPhone}}" class="muted">商家兑换账号：{{item.merchantName}}　{{item.merchantPhone}}</text></view>
  </block>
</view>
