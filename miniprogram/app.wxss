page { background: #f4f7f9; color: #203447; font-size: 28rpx; }
button { border-radius: 8rpx; }
button::after { border: 0; }
.page { padding: 28rpx; }
.card { margin-bottom: 24rpx; padding: 28rpx; border-radius: 12rpx; background: #fff; box-shadow: 0 3rpx 14rpx rgba(22, 64, 91, .06); }
.eyebrow { margin-bottom: 12rpx; color: #0b6cb7; font-size: 24rpx; font-weight: 700; }
.primary { background: #0b6cb7; color: #fff; }
.muted { color: #718294; font-size: 24rpx; line-height: 1.7; }
.field { margin-top: 20rpx; color: #42576a; font-size: 24rpx; font-weight: 600; }
.input { box-sizing: border-box; width: 100%; height: 80rpx; margin-top: 10rpx; padding: 0 18rpx; border: 1rpx solid #cbd8e1; border-radius: 8rpx; background: #fff; font-size: 28rpx; font-weight: 400; }
.row { display: flex; gap: 16rpx; align-items: center; }
.row .input { flex: 1; }
.code-button { flex: 0 0 190rpx; padding: 0; font-size: 24rpx; }
.service-item { display: flex; align-items: center; justify-content: space-between; min-height: 104rpx; padding: 0 4rpx; border-bottom: 1rpx solid #edf1f4; }
.service-item:last-child { border-bottom: 0; }
.service-item text:first-child { font-weight: 700; }
.arrow { color: #8aa0af; font-size: 38rpx; }
.consent { display: flex; gap: 12rpx; margin: 24rpx 0; color: #5f7181; font-size: 24rpx; line-height: 1.6; }

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

page {
  background: #f4f7f9;
  color: #203447;
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}
