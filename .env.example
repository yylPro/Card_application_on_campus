# Application
PORT=4173
NODE_ENV=production
DATA_FILE=./data/db.json
DB_DRIVER=json
DB_HOST=localhost
DB_PORT=1433
DB_NAME=CampusService
DB_USER=
DB_PASSWORD=
DB_TRUST_CERT=true

# Do not use the development defaults in production.
ADMIN_USER=operator
ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional external adapters. Leave empty until the corresponding service is authorized.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SCHOOL_VERIFY_URL=
SCHOOL_VERIFY_TOKEN=

# Required only when enabling WeChat mini-program launch from the QR dispatch page.
WECHAT_OFFICIAL_APP_ID=
WECHAT_OFFICIAL_APP_SECRET=
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_HOME=pages/home/home

# Non-production only. These numbers receive a developmentCode instead of real SMS.
TEST_PHONE_NUMBERS=13800000001,13800000002,13800000003,13900000001,13900000002
